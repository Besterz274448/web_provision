# Copy to .env. These are read on the server only: never prefix them with VITE_,
# because that would ship the token to the browser.

# Base URL of the tenant-provisioning service.
PROVISIONING_API_URL=http://localhost:8080
# Must equal SERVICE_TOKEN of the tenant-provisioning service.
PROVISIONING_SERVICE_TOKEN=

# Encrypts the session cookie, at least 32 characters. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
